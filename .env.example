# Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Sheet ID (the long string in the sheet URL)
SPREADSHEET_ID=your-spreadsheet-id-here

# Google Drive folder ID to upload finished videos
DRIVE_FOLDER_ID=your-drive-folder-id-here

# Path to Google OAuth credentials JSON (downloaded from Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path to cached OAuth token
GOOGLE_TOKEN_PATH=token.json
